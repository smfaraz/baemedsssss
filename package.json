{
  "name": "baemeds-storefront-us",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && vite build && node scripts/prerender.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:security": "tsx tests/security-boundary.test.ts && tsx tests/authorization-pipeline.test.ts && tsx tests/v1-api-contract.test.ts && tsx tests/admin-rbac.test.ts && tsx tests/us-market.test.ts",
    "test:concurrency": "tsx tests/concurrency-inventory.test.ts",
    "test:pagination": "tsx tests/storefront-pagination.test.ts",
    "test:migration": "tsx scripts/validate_inventory_migration.ts",
    "test": "npm run test:security && npm run test:concurrency && npm run test:pagination",
    "seed:supabase": "node scripts/seed-supabase-catalog.mjs",
    "shots": "node scripts/mobile-shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@supabase/supabase-js": "^2.110.8",
    "dompurify": "^3.4.12",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.564.0",
    "motion": "^12.38.0",
    "path": "^0.12.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "stripe": "^23.0.0",
    "tailwindcss": "^4.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-react": "^5.0.0",
    "jiti": "^2.6.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
